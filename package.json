{
  "name": "awsl-webadb",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "fetch-scrcpy-server 4.1",
    "dev": "concurrently -k \"bun --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "bun test",
    "start": "bun cli/index.ts serve",
    "fetch:scrcpy-server": "fetch-scrcpy-server 4.1",
    "cli": "bun cli/index.ts",
    "serve": "bun cli/index.ts serve",
    "build:cli": "bun run build:binary",
    "build:binary": "bun run build && bun build --compile --minify --asset ./dist cli/index.ts --outfile bin/awsl-webadb"
  },
  "dependencies": {
    "@yume-chan/adb": "3.0.0-beta.1",
    "@yume-chan/adb-scrcpy": "3.0.0-beta.1",
    "@yume-chan/adb-server-node-tcp": "3.0.0-beta.1",
    "@yume-chan/fetch-scrcpy-server": "3.0.0-beta.1",
    "@yume-chan/scrcpy": "3.0.0-beta.1",
    "@yume-chan/scrcpy-decoder-webcodecs": "3.0.0-beta.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@xhmikosr/decompress": "10.2.2",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "file-type": "21.3.4",
    "qs": "6.16.0",
    "shell-quote": "1.12.0"
  }
}
